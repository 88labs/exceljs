{
  "parserOptions": {
    "sourceType": "module",
    "ecmaVersion": 2022
  },
  "rules": {
    "import/extensions": ["off"],
    "node/no-unsupported-features/es-syntax": ["off"],
    "node/no-missing-import": ["off"],
    "import/no-unresolved": ["off"],
    "import/no-extraneous-dependencies": ["error", {"devDependencies": true}],
    "no-console": ["off"],
    "no-process-exit": ["off"],
    "node/no-process-exit": ["off"]
  }
}
